echo reinstall
php artisan db:wipe
rm -rf composer.lock vendor
sudo -u abuseio composer --working-dir=/opt/abuseio install
php artisan key:generate
php artisan migrate

echo caches
rm -rf bootstrap/cache/*.php
sudo -u abuseio composer --working-dir=/opt/abuseio clear-cache
sudo -u abuseio php /opt/abuseio/artisan cache:clear
sudo -u abuseio php /opt/abuseio/artisan config:clear
sudo -u abuseio php /opt/abuseio/artisan view:clear
sudo -u abuseio php /opt/abuseio/artisan route:clear
sudo -u abuseio composer --working-dir=/opt/abuseio dump-autoload

echo restart services
sudo systemctl restart abuseio_queue_collector
sudo systemctl restart abuseio_queue_email_incoming
sudo systemctl restart abuseio_queue_email_outgoing
sudo systemctl restart abuseio_queue_delegation

sudo -u abuseio php /opt/abuseio/artisan user:create admin@isp.local --password=password
sudo -u abuseio php /opt/abuseio/artisan role:assign --role=admin --user=admin@isp.local


echo reinstall
php artisan db:wipe
rm -rf composer.lock vendor
composer install
php artisan key:generate
php artisan migrate

echo caches
rm -rf bootstrap/cache/*.php
composer clear-cache
php artisan cache:clear
php artisan config:clear
php artisan view:clear
php artisan route:clear
composer dump-autoload

echo restart services
sudo systemctl restart abuseio_queue_collector
sudo systemctl restart abuseio_queue_email_incoming
sudo systemctl restart abuseio_queue_email_outgoing
sudo systemctl restart abuseio_queue_delegation

php artisan user:create admin@isp.local --password=password
php artisan role:assign --role=admin --user=admin@isp.local


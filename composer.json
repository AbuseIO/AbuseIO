{
	"name": "abuseio/abuseio",
	"description": "Open Source abusemanagement tool",
	"keywords": ["abuse", "abuseio"],
	"homepage": "http://abuse.io",
	"type": "project",
	"license": "GPL-2.0",
	"authors": [
		{
			"name": "AbuseIO Foundation",
			"email": "dev@abuse.io",
			"homepage": "http://abuse.io",
			"role": "Lead"
		}
	],
	"support": {
		"email": "dev@abuse.io",
		"issues": "https://github.com/AbuseIO/AbuseIO/issues",
		"irc": "irc://irc.freenode.net/abuseio",
		"source": "https://github.com/AbuseIO/AbuseIO",
		"docs": "https://abuse.io/resources/documentation/"
	},
	"suggest": {
		"ext-mcrypt": "Laravel / AbuseIO requirement"
	},
	"require": {
		"php": "^8.4",
		"ext-bcmath": "*",
		"ext-curl": "*",
		"ext-intl": "*",
		"ext-json": "*",
		"ext-libxml": "*",
		"ext-mailparse": "^3.2.0",
		"ext-mbstring": "*",
		"ext-zip": "*",
		"abuseio/collector-common": "5.0.*",
		"abuseio/collector-rbl": "5.0.*",
		"abuseio/collector-snds": "5.0.*",
		"abuseio/hook-common": "5.0.*",
		"abuseio/hook-log": "3.0.*",
		"abuseio/iodef": "3.0.1",
		"abuseio/notification-common": "5.0.*",
		"abuseio/notification-mail": "5.0.*",
		"abuseio/parser-abusehub": "5.0.*",
		"abuseio/parser-arf": "5.0.*",
		"abuseio/parser-blocklistde": "5.0.*",
		"abuseio/parser-cegtek": "5.0.*",
		"abuseio/parser-cleanmx": "5.0.*",
		"abuseio/parser-common": "5.0.*",
		"abuseio/parser-copyrightcompliance": "5.0.*",
		"abuseio/parser-cyscon": "5.0.*",
		"abuseio/parser-fbl": "5.0.*",
		"abuseio/parser-google": "5.0.*",
		"abuseio/parser-haveibeenpwned": "5.0.*",
		"abuseio/parser-ipechelon": "5.0.*",
		"abuseio/parser-netcraft": "5.0.*",
		"abuseio/parser-projecthoneypot": "5.0.*",
		"abuseio/parser-shadowserver": "5.0.*",
		"abuseio/parser-spamcop": "5.0.*",
		"abuseio/parser-spamexperts": "5.0.*",
		"abuseio/parser-webiron": "5.0.*",
		"composer/class-map-generator": "1.6.*",
		"guzzlehttp/guzzle": "7.10.*",
		"illuminated/helper-functions": "^12.0",
		"jeremykendall/php-domain-parser": "6.4.*",
		"abuseio/singleton": "^2.0",
		"kruisdraad/phpmailer": "v5.2.21",
		"laravel/framework": "^12.0",
		"laravel/helpers": "^1.8",
		"laravel/tinker": "^2.10",
		"league/fractal": "0.20.*",
		"madnest/madzipper": "^1.6",
		"php-mime-mail-parser/php-mime-mail-parser": "9.*",
		"sabre/uri": "3.0.*",
		"sabre/xml": "4.0.*",
		"spatie/laravel-html": "^3.12",
		"yajra/laravel-datatables-oracle": "12.6.*"
	},
  "require-dev": {
    "beyondcode/laravel-dump-server": "^2.1",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.1",
    "phpunit/phpunit": "^12.0",
    "fakerphp/faker": "^1.23"
  },
	"autoload": {
		"psr-4": {
			"AbuseIO\\": "app/",
			"Log\\": "app/",
			"tests\\": "tests/",
		        "Database\\Factories\\": "database/factories/",
		        "Database\\Seeders\\": "database/seeders/"
		},
                "classmap": [
                    "vendor/abuseio/"
                ]
	},
	"autoload-dev": {
		"psr-4": {
			"tests\\": "tests/"
		}
	},
	"scripts": {
		"post-install-cmd": [
			"php artisan clear-compiled",
			"php artisan queue:restart"
		],
		"post-update-cmd": [
			"php artisan clear-compiled",
			"php artisan queue:restart"
		],
		"post-create-project-cmd": [
			"php -r \"copy('.env.example', '.env');\"",
			"php artisan key:generate",
			"php artisan app:id"
		],
		"post-autoload-dump": [
			"Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
			"@php artisan package:discover"
		]
	},
	"config": {
		"preferred-install": "dist",
		"sort-packages": true,
		"optimize-autoloader": true
	},
	"extra": {
		"branch-alias": {
			"dev-master": "5.0-dev"
		}
	},
	"minimum-stability": "stable"
}
